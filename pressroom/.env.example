# Copy to .env and fill in what you use. Nothing here belongs in git.

# --- capture ---------------------------------------------------------------
# https://readwise.io/access_token
READWISE_TOKEN=
# The shared secret from `wrangler secret put INBOX_TOKEN`. Same value on the
# Worker and here.
INBOX_TOKEN=

# --- curation --------------------------------------------------------------
# Optional if you have run `ant auth login`; required in CI.
ANTHROPIC_API_KEY=

# --- the proof email -------------------------------------------------------
RESEND_API_KEY=

# --- automated ordering (only if print.vendor is "peecho") -----------------
PEECHO_API_KEY=
PEECHO_MERCHANT_ID=
# Public HTTPS base where the built PDF can be fetched by the printer.
PUBLIC_ASSET_BASE=

# --- rendering -------------------------------------------------------------
# Only if Playwright's bundled Chromium is missing or pinned elsewhere.
PRESSROOM_CHROMIUM_PATH=

# --- logging ---------------------------------------------------------------
# debug | info | warn | error
PRESSROOM_LOG_LEVEL=info
