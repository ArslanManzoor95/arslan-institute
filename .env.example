# Environment variables for the brochure capture Worker (worker/).
# These are set as Cloudflare Worker secrets in production
# (`wrangler secret put <NAME>`), and placed in worker/.dev.vars for local dev.
# Do not commit real values.

# Resend API key.
RESEND_API_KEY=

# Verified sender on the arslaninstitute.com domain, e.g. hello@arslaninstitute.com.
FROM_EMAIL=

# Where lead notifications are sent, and reply-to on the brochure email.
NOTIFY_EMAIL=arslan@arslaninstitute.com

# Hosted link to the brochure PDF (used until the real URL is provided).
BROCHURE_URL=
